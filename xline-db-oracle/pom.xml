<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.csf.xline</groupId>
        <artifactId>xline</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>xline-db-oracle</artifactId>
    <name>xline-db-oracle</name>
    <description>Oracle 节点支持（11g+）：驱动 + anyline 数据源适配器 + 节点初始化</description>

    <dependencies>
        <dependency>
            <groupId>com.csf.xline</groupId>
            <artifactId>xline-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csf.xline</groupId>
            <artifactId>xline-db-support</artifactId>
        </dependency>

        <!--
            Oracle 驱动 artifact 与版本均随分支切换：
            jdk21 分支 ojdbc11 23.x 线最新（仅支持连接 19c+ 服务端）；
            jdk8 分支 ojdbc8 21.x 线最新（兼容 11.2.0.4+ 全部服务端，保留 11g 连接能力）。
        -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>${oracle.artifactId}</artifactId>
        </dependency>

        <!-- anyline Oracle 适配器 -->
        <dependency>
            <groupId>org.anyline</groupId>
            <artifactId>anyline-data-jdbc-oracle</artifactId>
        </dependency>
    </dependencies>

    <!--
        Flyway 10 起按数据库拆分：jdk21 分支（Flyway 13）需显式引入 Oracle 模块；
        jdk8 分支（Flyway 9）对应支持内置于 flyway-core，无需额外依赖。
        与根 POM 同名的 jdk21 profile：'-P !jdk21,jdk8' 强制 jdk8 分支时按 ID 一并禁用本模块，
        避免 JDK 21 上强制跨分支构建时误引 Flyway 13 的按库模块。
    -->
    <profiles>
        <profile>
            <id>jdk21</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-database-oracle</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
